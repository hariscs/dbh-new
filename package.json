{
  "name": "dbh",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --dir apps/frontend dev",
    "build": "pnpm --dir apps/frontend build",
    "start": "pnpm --dir apps/frontend start",
    "typecheck": "pnpm --dir apps/frontend typecheck",
    "knip": "pnpm --dir apps/frontend knip",
    "dev:backend": "pnpm --dir apps/backend dev",
    "build:backend": "pnpm --dir apps/backend build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "docker:build": "docker build -t dbh-backend .",
    "wp:up": "docker compose --profile import up -d wp-mysql",
    "wp:load": "sh devops/load-wp-dump.sh",
    "import:wp": "pnpm --dir apps/backend import:wp",
    "parity": "pnpm --dir apps/backend parity",
    "capture:baselines": "pnpm --dir apps/backend capture:baselines",
    "parity:all": "pnpm --dir apps/backend parity:all"
  }
}
