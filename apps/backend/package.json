{
  "name": "dbh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3003",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev -p 3003",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "import:wp": "cross-env NODE_OPTIONS=--no-deprecation payload run src/import/wordpress.ts",
    "parity": "cross-env NODE_OPTIONS=--no-deprecation payload run src/import/parity.ts",
    "capture:baselines": "cross-env NODE_OPTIONS=--no-deprecation payload run src/import/capture-baselines.ts",
    "parity:all": "cross-env NODE_OPTIONS=--no-deprecation payload run src/import/parity-all.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3003"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "mysql2": "^3.24.6",
    "next": "16.3.3",
    "payload": "3.92.1",
    "php-serialize": "^5.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  }
}
