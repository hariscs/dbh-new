# Copy to .env for local development (git-ignored).
# In deployed environments the same variables are supplied at container start.

# Matches the `db` service in the root docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://dbh:dbh@localhost:5435/dbh

# Any long random string locally: `openssl rand -hex 32`. Required in production.
PAYLOAD_SECRET=

# WordPress dump loaded into the `wp-mysql` service (`pnpm wp:up`, `pnpm wp:load <dump.sql.gz>`).
WP_DATABASE_URL=mysql://wordpress:wordpress@127.0.0.1:3307/wordpress

# Folder of saved prod page-data responses, with paths.txt one level up (`pnpm parity`).
PARITY_BASELINE_DIR=
