# Copy to .env for local development (git-ignored).
# In deployed environments the same variables are supplied at container start.

# Matches the `db` service in the root docker-compose.yml (`pnpm db:up`).
DATABASE_URL=postgres://dbh:dbh@localhost:5433/dbh

# Any long random string locally: `openssl rand -hex 32`. Required in production.
PAYLOAD_SECRET=
